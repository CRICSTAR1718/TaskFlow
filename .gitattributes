# Normalise line endings for everyone, on every OS.
# Go files and YAML workflows are consumed by Linux CI â€” they must be LF.
* text=auto eol=lf

# Keep these binary (no eol conversion, no diff churn).
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary

# Windows-only scripts may keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf

# SQL migrations are hashed by golang-migrate - never let git touch their bytes.
migrations/** -text
